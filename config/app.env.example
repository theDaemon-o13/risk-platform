# Скопируйте в `config/app.env` и заполните значения.
# При деплое в изолированную сеть передаётся вместе с tar-релизом.

# ===== PostgreSQL =====
POSTGRES_USER=risk_platform
POSTGRES_PASSWORD=ChangeMe_StrongPgPassword_2026
POSTGRES_DB=risk_platform

# ===== API =====
# Соберётся в Docker compose как postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# JWT-секрет — ОБЯЗАТЕЛЬНО уникальный, минимум 32 символа.
# Сгенерировать: `openssl rand -base64 48`
JWT_SECRET=CHANGE_ME_PLEASE_USE_OPENSSL_RAND_BASE64_48

# ===== Bootstrap первого админа =====
# Учётка создаётся при ПЕРВОМ запуске API, если пользователя с таким логином ещё нет.
# В последующих запусках эти переменные игнорируются.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=ChangeMeOnFirstLogin!
